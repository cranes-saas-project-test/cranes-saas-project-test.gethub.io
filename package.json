{
    "name": "crane-alerts-system",
    "version": "1.0.0",
    "description": "نظام إدارة الرافعات والمخازن - شركة المقاولات التخصصية",
    "scripts": {
        "start": "npm run dev",
        "dev": "concurrently \"npm run server\" \"npm run client\"",
        "server": "node server/index.js",
        "client": "cd client && npm start",
        "install-all": "npm install && cd client && npm install",
        "build": "cd client && npm run build",
        "setup": "npm install && cd client && npm install"
    },
    "dependencies": {
        "axios": "^1.13.6",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "jsonwebtoken": "^9.0.2",
        "lucide-react": "^1.6.0",
        "pg": "^8.11.3",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-router-dom": "^7.13.2",
        "socket.io": "^4.6.1"
    },
    "devDependencies": {
        "concurrently": "^8.2.2"
    }
}
