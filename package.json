{
    "name": "crane-alerts-system",
    "version": "1.0.0",
    "description": "نظام إدارة الرافعات والمخازن - شركة المقاولات التخصصية",
    "scripts": {
        "start": "node server/index.js",
        "dev": "concurrently \"npm run server\" \"npm run client\"",
        "server": "node server/index.js",
        "client": "cd client && npm start",
        "install-all": "npm install && cd client && npm install",
        "build": "cd client && npm run build"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "jsonwebtoken": "^9.0.2",
        "next": "^16.2.1",
        "pg": "^8.11.3",
        "socket.io": "^4.6.1",
        "tailwindcss": "^4.2.2"
    },
    "devDependencies": {
        "concurrently": "^8.2.2"
    }
}
